# ==========================================
# KONEKSI SFTP / FTP SERVER UTAMA RAZNAR
# ==========================================
# Dapatkan data ini di panel Pterodactyl Raznar (https://console-ptero.raznar.id):
# Masuk ke server Valdora -> Tab 'Settings' -> Bagian 'SFTP Details'
FTP_TYPE=sftp
FTP_HOST=console-ptero.raznar.id
FTP_PORT=2022
FTP_USER=username.xxxxxx
FTP_PASSWORD=password_panel_anda
FTP_REMOTE_PATH=/plugins

# ==========================================
# (OPSIONAL) DATABASE MYSQL / MARIADB REMOTE
# ==========================================
# Jika plugin nLogin menggunakan remote MySQL/MariaDB
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=nLogin

# JWT Secret untuk mengenkripsi sesi login pemain di browser
JWT_SECRET=valdora_secret_rpg_auth_2026_super_secure
PORT=3001

# ==========================================
# (OPSIONAL) DISCORD BOT & GALLERY SYNC
# ==========================================
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_guild_id
DISCORD_GALLERY_CHANNEL_ID=your_channel_id
DISCORD_MEDIA_CHANNEL_ID=your_channel_id
